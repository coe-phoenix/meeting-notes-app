PORT=80

# Live-recording segment length in minutes. Long recordings are captured in
# segments of this length; on stop they're concatenated and transcribed in ONE
# Soniox pass (whole-meeting context = better code-switch accuracy).
SEGMENT_MINUTES=5

# Auto-delete each job and its files this many days after creation (a visible
# retention window, surfaced in the UI). Defaults to 30 if unset/invalid.
RETENTION_DAYS=30

# ---------- Access control ----------
# Two modes:
#  • Leave AUTH unset → legacy shared-password gate below (single user).
#  • AUTH=magic       → per-user passwordless magic-link login (Phase 5). This
#    REPLACES APP_PASSWORD and requires the Resend + APP_BASE_URL settings below.
AUTH=

# Shared-password gate (used only when AUTH is unset). If blank, the app is
# PUBLIC to anyone with the IP.
APP_PASSWORD=

# ---------- Magic-link auth (only when AUTH=magic) ----------
# Public base URL of this app — used to build the sign-in link and to decide
# whether the session cookie is marked Secure (https:// => Secure).
APP_BASE_URL=
# Resend (https://resend.com) sends the login emails. If RESEND_API_KEY is blank
# the link is written to the server log instead (dev fallback).
RESEND_API_KEY=
RESEND_FROM=Meeting Notes <onboarding@resend.dev>
# Comma-separated emails that get the admin usage view.
ADMIN_EMAILS=
# Session + token lifetimes (optional).
SESSION_TTL_DAYS=30
LOGIN_TOKEN_TTL_MINUTES=15

# ---------- Quotas ----------
# Per-user transcribed-minutes cap per calendar month. 0 (default) = unlimited.
# Enforced at job creation (only meaningful with AUTH=magic).
QUOTA_MINUTES=0

# ---------- Transcription providers (masked as "Model 1" / "Model 2" in the UI) ----------
# Model 1 — Soniox (https://console.soniox.com)
SONIOX_API_KEY=

# Model 2 — Google Gemini (https://aistudio.google.com/apikey). Optional; the
# model toggle only appears when both providers are configured. GEMINI_MODEL is
# overridable so it can track Gemini's current audio-capable models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram — reusing Hermes' existing bot. Update when ready.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Phase 5.5: going public (encryption at rest + abuse controls) ----------
# Envelope encryption at rest. Off unless ENCRYPT_AT_REST=1 AND MASTER_KEY is set.
# MASTER_KEY must be a base64-encoded 32-byte key — generate one with:
#   openssl rand -base64 32
# The master key wraps per-user data keys; audio + transcripts + summaries are
# AES-256-GCM encrypted on disk/DB. Keep MASTER_KEY OUT of the database (this .env
# at minimum; a real secrets manager when you can). Losing it = losing the data.
ENCRYPT_AT_REST=
MASTER_KEY=

# Shorter retention ceiling for a public deployment (auth on). Effective retention
# is min(RETENTION_DAYS, PUBLIC_RETENTION_DAYS) when AUTH=magic. Default 14.
PUBLIC_RETENTION_DAYS=14

# Uploads allowed per user (or IP) per hour — throttles scripted abuse before it
# costs anything. 0 disables. Default 60.
UPLOAD_RATE_PER_HOUR=60

# ---------- Admin AI pipeline (meeting minutes → generated POC → GitHub PR) ----------
# Admin-only. A run streams a Claude pass over a meeting's minutes, then opens a
# pull request in a NEW PRIVATE repo. If GITHUB_TOKEN is unset, runs still stream
# the generated code but skip repo creation. Token needs "repo" scope.
GITHUB_TOKEN=
# Optional: create repos under this org/user. Defaults to the token's own account.
GITHUB_OWNER=
#
# Optional MCP tools for the pipeline (e.g. the Dojo marketplace MCP): NOT set here
# — configure them in the app at Admin → AI Pipeline → "MCP tools". Enter the MCP
# server URL and click Connect for OAuth-protected servers (or paste a static
# token). OAuth connect needs APP_BASE_URL set (above) for the redirect
# ${APP_BASE_URL}/api/admin/pipeline/mcp/callback. All MCP state is stored in the
# DB (settings keys pipeline_mcp_*), so it changes without a redeploy.
