PORT=80

# Live-recording segment length in minutes. Long recordings are captured in
# segments of this length; on stop they're concatenated and transcribed in ONE
# Soniox pass (whole-meeting context = better code-switch accuracy).
SEGMENT_MINUTES=5

# Auto-delete each job and its files this many days after creation (a visible
# retention window, surfaced in the UI). Defaults to 30 if unset/invalid.
RETENTION_DAYS=30

# Password gate for the web UI. If blank, the app is PUBLIC to anyone with the IP.
APP_PASSWORD=

# Soniox — https://console.soniox.com
SONIOX_API_KEY=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram — reusing Hermes' existing bot. Update when ready.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
