PORT=80

# Live-recording segment length in minutes. Recordings longer than this are
# auto-transcribed every SEGMENT_MINUTES; on stop the full transcript goes to Claude.
SEGMENT_MINUTES=5

# Password gate for the web UI. If blank, the app is PUBLIC to anyone with the IP.
APP_PASSWORD=

# Soniox — https://console.soniox.com
SONIOX_API_KEY=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram — reusing Hermes' existing bot. Update when ready.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
